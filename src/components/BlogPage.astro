---
import { getLocale, getTranslator, localizedPath } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = getTranslator(locale);
import Layout from '../layouts/Layout.astro';
import PostList from './PostList.astro';
import SiteShell from './SiteShell.astro';
import { getCollection } from 'astro:content';
import { isBlogPostVisible } from '../lib/blog';
import '../styles/site.css';

const posts = (await getCollection('blog', ({ data }) => isBlogPostVisible(data) && data.locale === locale)).sort(
    (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const siteUrl = Astro.site ?? Astro.url;
const blogUrl = new URL(localizedPath('/blog/', locale), siteUrl).href;
const homeUrl = new URL(localizedPath('/', locale), siteUrl).href;
const blogStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    inLanguage: locale,
    '@id': `${blogUrl}#blog`,
    url: blogUrl,
    name: 'Blog | Kryštof Lískovec',
    description: t("Random adventures and struggles - mostly about software and whatever I am figuring out."),
    author: {
        '@type': 'Person',
        '@id': `${homeUrl}#person`,
        name: 'Kryštof Lískovec',
        url: homeUrl,
    },
};
---

<Layout
    title="Blog | Kryštof Lískovec"
    description={t("Random adventures and struggles from Kryštof Lískovec - mostly about software and whatever he's figuring out.")}
    structuredData={blogStructuredData}
>
    <SiteShell mainClass="blog-page">
        <section class="blog-hero">
            <h1>{t("random adventures")}<br /><span>{t("and struggles.")}</span></h1>
            <p>{t("mostly about software and whatever i happen to be figuring out. sometimes with opinions included.")}</p>
        </section>
        <section class="post-index">
            <div class="section-label">
                <span>{t("all posts")}</span><a class="blog-link" href={localizedPath("/rss.xml", locale)}>{t("[ subscribe via rss → ]")}</a>
            </div>
            <PostList posts={posts} />
        </section>
    </SiteShell>
</Layout>
