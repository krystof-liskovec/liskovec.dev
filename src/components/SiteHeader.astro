---
const onHomepage = Astro.url.pathname === '/';
const onBlog = Astro.url.pathname.startsWith('/blog');
---

<header class="site-header">
    <div class="brand-lockup">
        <a class="wordmark" href="/" aria-label="Kryštof Lískovec home"><span>/home/</span>krystof-liskovec</a>
        <p class="eyebrow">devops · software developer</p>
    </div>
    <nav aria-label="Primary navigation">
        <a href={onHomepage ? '#about' : '/#about'}>[ about ]</a>
        <a
            href={onHomepage ? '#contact' : '/#contact'}
            aria-current={onHomepage && Astro.url.hash === '#contact' ? 'page' : undefined}>[ contact ]</a
        >
        <a href="/blog" aria-current={onBlog ? 'page' : undefined}>[ blog ]</a>
    </nav>
</header>
