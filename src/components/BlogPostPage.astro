---
import { getLocale, getTranslator, localizedPath, dateLocales, locales } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = getTranslator(locale);
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { getBlogImageSrc, getBlogSlug, isBlogPostVisible } from '../lib/blog';
import Layout from '../layouts/Layout.astro';
import SiteShell from './SiteShell.astro';
import PostSummary from './PostSummary.astro';
import '../styles/site.css';


interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const slug = getBlogSlug(post.id);
const languages = (await getCollection('blog', ({ data }) => isBlogPostVisible(data)))
    .filter(entry => getBlogSlug(entry.id) === slug)
    .map(entry => entry.data.locale);
const articleLanguages = languages.includes('en') ? [...locales] : languages;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat(dateLocales[locale], {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
}).format(post.data.published);
const updated = post.data.updated
    ? new Intl.DateTimeFormat(dateLocales[locale], {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
      }).format(post.data.updated)
    : null;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(localizedPath(`/blog/${slug}/`, post.data.locale), siteUrl).href;
const homeUrl = new URL(localizedPath('/', locale), siteUrl).href;
const coverImage = getBlogImageSrc(post.data.image);
const coverMetadata = typeof post.data.image === 'object' ? post.data.image : undefined;
const articleImageUrl = coverImage ? new URL(coverImage, siteUrl).href : undefined;
const articleStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    inLanguage: post.data.locale,
    '@id': `${canonicalUrl}#article`,
    mainEntityOfPage: canonicalUrl,
    url: canonicalUrl,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.published.toISOString(),
    dateModified: (post.data.updated ?? post.data.published).toISOString(),
    author: {
        '@type': 'Person',
        '@id': `${homeUrl}#person`,
        name: 'Kryštof Lískovec',
        url: homeUrl,
    },
    isPartOf: {
        '@type': 'Blog',
        '@id': `${new URL(localizedPath('/blog/', post.data.locale), siteUrl).href}#blog`,
    },
    keywords: post.data.tags,
    ...(articleImageUrl ? { image: articleImageUrl } : {}),
};
---

<Layout
    title={`${post.data.title} | Kryštof Lískovec`}
    description={post.data.description}
    image={coverImage}
    imageWidth={coverMetadata?.width}
    imageHeight={coverMetadata?.height}
    imageAlt={post.data.imageAlt ?? post.data.title}
    type="article"
    canonical={canonicalUrl}
    publishedTime={post.data.published.toISOString()}
    modifiedTime={(post.data.updated ?? post.data.published).toISOString()}
    tags={post.data.tags}
    structuredData={articleStructuredData}
    languages={languages}
>
    <SiteShell mainClass="post-page" languages={articleLanguages}>
        <article>
            <a class="post-back" href={localizedPath("/blog/", locale)}>{t("[ ← ALL POSTS ]")}</a>
            <header class="post-header">
                <div class="post-meta">
                    <span>
                        <time datetime={post.data.published.toISOString()}>{published}</time>
                        {updated && <time datetime={post.data.updated!.toISOString()}> · {t("updated")} {updated}</time>}
                    </span><span>{post.data.tags.join(' · ')}</span>
                </div>
                <h1>{post.data.title}</h1>
                <p>{post.data.description}</p>
                {post.data.summary && (
                    <PostSummary summary={post.data.summary} id={`post-summary-${locale}-${slug}-detail`} />
                )}
            </header>
            {
                coverImage && (
                    <figure class="post-cover">
                        <img
                            src={coverImage}
                            alt={post.data.imageAlt ?? ''}
                            width={coverMetadata?.width}
                            height={coverMetadata?.height}
                        />
                    </figure>
                )
            }
            <div class="post-body"><Content /></div>
            <dialog
                class="post-image-viewer"
                aria-label={t('Image preview')}
                data-open-label={t('Open larger image')}
            >
                <button class="post-image-viewer-close" type="button" aria-label={t('Close image preview')}>
                    ×
                </button>
                <img alt="" />
            </dialog>
        </article>
    </SiteShell>
</Layout>

<script>
    const article = document.querySelector('.post-page article');
    const imageViewer = document.querySelector<HTMLDialogElement>('.post-image-viewer');
    const viewerImage = imageViewer?.querySelector('img');
    const closeViewerButton = imageViewer?.querySelector('button');

    if (article && imageViewer && viewerImage && closeViewerButton) {
        const openLabel = imageViewer.dataset.openLabel ?? 'Open larger image';

        article.querySelectorAll('.post-cover img, .post-body img').forEach((image) => {
            if (image.closest('a')) return;

            const imageLink = document.createElement('a');
            imageLink.className = 'post-image-link';
            imageLink.href = image.currentSrc || image.src;
            imageLink.title = openLabel;
            imageLink.setAttribute('aria-label', `${image.alt ? `${image.alt} — ` : ''}${openLabel}`);
            image.before(imageLink);
            imageLink.append(image);

            imageLink.addEventListener('click', (event) => {
                if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                event.preventDefault();
                viewerImage.src = imageLink.href;
                viewerImage.alt = image.alt;
                imageViewer.showModal();
            });
        });

        closeViewerButton.addEventListener('click', () => imageViewer.close());
        imageViewer.addEventListener('click', (event) => {
            if (event.target === imageViewer) imageViewer.close();
        });
    }
</script>
