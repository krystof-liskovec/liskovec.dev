---
const pathname = Astro.url.pathname;
const onHomepage = pathname === '/';
const onBlogIndex = pathname === '/blog' || pathname === '/blog/';
---

<footer>
	<span>© 2026 Kryštof Lískovec</span>
	{onHomepage ? (
		<span>made with curiosity + caffeine</span>
	) : onBlogIndex ? (
		<a href="/">← back home</a>
	) : (
		<a href="/blog">← back to blog</a>
	)}
</footer>
