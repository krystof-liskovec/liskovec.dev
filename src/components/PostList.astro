---
import type { CollectionEntry } from 'astro:content';
import { getBlogImageSrc, getBlogSlug } from '../lib/blog';
import { getLocale, getTranslator, localizedPath, dateLocales } from '../i18n';
import PostSummary from './PostSummary.astro';

interface Props {
    posts: CollectionEntry<'blog'>[];
    emptyMessage?: string;
}

const locale = getLocale(Astro.url.pathname);
const t = getTranslator(locale);
const { posts, emptyMessage = t('Nothing here yet.') } = Astro.props;
const formatDate = (date: Date) =>
    new Intl.DateTimeFormat(dateLocales[locale], {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
    }).format(date);
---

<div class="post-list">
    {
        posts.length > 0 ? (
            posts.map((post) => {
                const postUrl = localizedPath(`/blog/${getBlogSlug(post.id)}/`, locale);
                const summaryId = `post-summary-${locale}-${getBlogSlug(post.id)}`;

                return (
                    <article class="post-card">
                        <a class="post-card-media" href={postUrl} aria-label={post.data.title}>
                            <img
                                src={getBlogImageSrc(post.data.thumbnail ?? post.data.image) ?? '/og-default.png?v=2'}
                                alt={post.data.thumbnailAlt ?? post.data.imageAlt ?? post.data.title}
                                width="180"
                                height="104"
                                loading="lazy"
                                decoding="async"
                            />
                        </a>
                        <div class="post-card-body">
                            <div class="post-card-meta">
                                <div class="post-card-date">{formatDate(post.data.published)}</div>
                                {post.data.tags.length > 0 && (
                                    <span class="post-card-tags">{post.data.tags.join(' · ')}</span>
                                )}
                            </div>
                            <a class="post-card-content-link" href={postUrl}>
                                <h2>{post.data.title}</h2>
                                <p>{post.data.description}</p>
                            </a>
                            {post.data.summary && <PostSummary summary={post.data.summary} id={summaryId} />}
                        </div>
                    </article>
                );
            })
        ) : (
            <div class="post-list-empty">{emptyMessage}</div>
        )
    }
</div>
