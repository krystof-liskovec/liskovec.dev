---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteShell from '../../components/SiteShell.astro';
import '../../styles/site.css';

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => !data.draft);
    return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat('en-GB', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
}).format(post.data.published);
const updated = post.data.updated
    ? new Intl.DateTimeFormat('en-GB', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
      }).format(post.data.updated)
    : null;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/blog/${post.id}/`, siteUrl).href;
const homeUrl = new URL('/', siteUrl).href;
const articleImageUrl = post.data.image ? new URL(post.data.image, siteUrl).href : undefined;
const articleStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    mainEntityOfPage: canonicalUrl,
    url: canonicalUrl,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.published.toISOString(),
    dateModified: (post.data.updated ?? post.data.published).toISOString(),
    author: {
        '@type': 'Person',
        '@id': `${homeUrl}#person`,
        name: 'Kryštof Lískovec',
        url: homeUrl,
    },
    isPartOf: {
        '@type': 'Blog',
        '@id': `${new URL('/blog/', siteUrl).href}#blog`,
    },
    keywords: post.data.tags,
    ...(articleImageUrl ? { image: articleImageUrl } : {}),
};
---

<Layout
    title={`${post.data.title} — Kryštof Lískovec`}
    description={post.data.description}
    image={post.data.image}
    imageAlt={post.data.imageAlt ?? post.data.title}
    type="article"
    publishedTime={post.data.published.toISOString()}
    modifiedTime={(post.data.updated ?? post.data.published).toISOString()}
    tags={post.data.tags}
    structuredData={articleStructuredData}
>
    <SiteShell mainClass="post-page">
        <article>
            <a class="post-back" href="/blog">← all posts</a>
            <header class="post-header">
                <div class="post-meta">
                    <span>
                        <time datetime={post.data.published.toISOString()}>{published}</time>
                        {updated && <time datetime={post.data.updated!.toISOString()}> · updated {updated}</time>}
                    </span><span>{post.data.tags.join(' · ')}</span>
                </div>
                <h1>{post.data.title}</h1>
                <p>{post.data.description}</p>
            </header>
            {
                post.data.image && (
                    <figure class="post-cover">
                        <img src={post.data.image} alt={post.data.imageAlt ?? ''} />
                    </figure>
                )
            }
            <div class="post-body"><Content /></div>
        </article>
    </SiteShell>
</Layout>
