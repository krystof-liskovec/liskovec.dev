---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import SiteShell from '../../components/SiteShell.astro';
import { getCollection } from 'astro:content';
import '../../styles/site.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const siteUrl = Astro.site ?? Astro.url;
const blogUrl = new URL('/blog/', siteUrl).href;
const homeUrl = new URL('/', siteUrl).href;
const blogStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${blogUrl}#blog`,
    url: blogUrl,
    name: 'Blog | Kryštof Lískovec',
    description: 'Random adventures and struggles - mostly about software and whatever I am figuring out.',
    author: {
        '@type': 'Person',
        '@id': `${homeUrl}#person`,
        name: 'Kryštof Lískovec',
        url: homeUrl,
    },
};
---

<Layout
    title="Blog | Kryštof Lískovec"
    description="Random adventures and struggles from Kryštof Lískovec - mostly about software and whatever he's figuring out."
    structuredData={blogStructuredData}
>
    <SiteShell mainClass="blog-page">
        <section class="blog-hero">
            <h1>random adventures<br /><span>and struggles.</span></h1>
            <p>mostly about software and whatever i happen to be figuring out. sometimes with opinions included.</p>
        </section>
        <section class="post-index">
            <div class="section-label">
                <span>all posts</span><a class="blog-link" href="/rss.xml">[ subscribe via rss → ]</a>
            </div>
            <PostList posts={posts} />
        </section>
    </SiteShell>
</Layout>
