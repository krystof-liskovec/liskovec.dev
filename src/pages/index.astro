---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import SiteShell from '../components/SiteShell.astro';
import { getCollection } from 'astro:content';
import '../styles/site.css';

const featuredPosts = (await getCollection('blog', ({ data }) => !data.draft && data.featured))
	.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
	.slice(0, 3);
---

<Layout>
	<SiteShell>
			<section class="solar-hero">
				<div class="solar-heading"><h1>somewhere<br /><span class="zoom-location-frame"><span id="zoom-location">in the solar system.</span></span></h1></div>
				<div class="solar-system" id="solar-system" aria-label="A live, approximate ASCII orrery of the solar system">
					<canvas id="solar-canvas" role="img" aria-label="ASCII solar system with live approximate planetary positions"></canvas>
					<button class="object-focus-return" id="object-focus-return" type="button" hidden>[ ← return ]</button>
					<div class="cosmic-zoom-control">
						<label class="sr-only" for="cosmic-zoom">Zoom between the Solar System and the Milky Way</label>
						<div class="cosmic-zoom-scale">
							<span aria-hidden="true">MILKY WAY</span>
							<input id="cosmic-zoom" type="range" min="0" max="100" value="0" step="1" />
							<span aria-hiddeny="true">SOL</span>
						</div>
						<output id="cosmic-zoom-status" for="cosmic-zoom">LOCAL SYSTEM</output>
					</div>
					<div class="solar-caption"><span id="solar-time">UTC / BROWSER TIME</span><span>drag to explore · double-click to reset</span></div>
				</div>
				<div class="hero-footer"><a href="#about">↓ scroll to learn more</a></div>
			</section>
			<section class="content-section" id="about"><div class="section-label"><span>01 / about me</span><span>devops + software development</span></div><div class="about-grid"><h2>i build reliable software and the systems it runs on.</h2><div class="about-copy"><p>hi there, i’m Kryštof Lískovec, a DevOps and software developer from the Czech Republic. my background began in backend development and gradually expanded into DevOps, infrastructure, and automation.</p><p>these days my work sits between both. i still build services and internal tools, while also working with containers, on-prem infrastructure, CI/CD, and deployments that should not wake anyone up at night. along the way, i’ve helped move older codebases towards safer, cleaner systems.</p><p>outside work, i’m usually somewhere around Linux, homelabs, or open-source projects.</p></div></div></section>
			<section class="content-section skills-section" id="skills"><div class="section-label"><span>02 / toolbox</span><span>tools &amp; tech</span></div><div class="skill-groups"><div><span>operations</span><p>Linux · Docker · GitLab CI/CD · IaC · Nginx · Consul · OpenBao · Nexus</p></div><div><span>backend</span><p>Go <3 · NestJS · Symfony</p></div><div><span>data</span><p>PostgreSQL · MySQL · MongoDB · Elasticsearch · Redis · Kibana</p></div><div><span>frontend</span><p>React · Svelte · Nuxt</p></div></div></section>
			<div class="closing-grid"><section class="content-section" id="blog"><div class="section-label"><span>03 / featured posts</span><span>sometimes with opinions included</span></div><PostList posts={featuredPosts} /><div class="blog-actions"><a class="blog-link" href="/blog">[ visit the blog → ]</a></div></section><section class="content-section compact" id="contact"><div class="section-label"><span>04 / contact</span><span>get in touch</span></div><div class="contact-links"><a href="mailto:krystof@liskovec.dev">email <span>↗</span></a></div></section></div>
	</SiteShell>
</Layout>

<script>
	import '../scripts/orrery.ts';

	let arrivalFrame = 0;
	const showSectionArrival = (section: HTMLElement) => {
		section.classList.remove('is-arriving');
		void section.offsetWidth;
		section.classList.add('is-arriving');
		section.querySelector('.section-label')?.addEventListener('animationend', () => {
			section.classList.remove('is-arriving');
		}, { once: true });
		window.setTimeout(() => section.classList.remove('is-arriving'), 1000);
	};

	const waitForScrollEnd = (section: HTMLElement) => {
		cancelAnimationFrame(arrivalFrame);
		const startedAt = performance.now();
		let previousY = window.scrollY;
		let moved = false;
		let stableFrames = 0;
		const check = () => {
			const currentY = window.scrollY;
			if (Math.abs(currentY - previousY) > .5) {
				moved = true;
				stableFrames = 0;
			} else {
				stableFrames += 1;
			}
			previousY = currentY;
			const elapsed = performance.now() - startedAt;
			if ((moved && stableFrames >= 4) || (!moved && elapsed > 140) || elapsed > 1600) {
				showSectionArrival(section);
				return;
			}
			arrivalFrame = requestAnimationFrame(check);
		};
		arrivalFrame = requestAnimationFrame(check);
	};

	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
		link.addEventListener('click', () => {
			const id = link.hash.slice(1);
			const section = document.getElementById(id);
			if (section?.classList.contains('content-section')) waitForScrollEnd(section);
		});
	});

	if (window.location.hash) {
		const initialSection = document.getElementById(window.location.hash.slice(1));
		if (initialSection?.classList.contains('content-section')) waitForScrollEnd(initialSection);
	}
</script>
