---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import SiteShell from '../components/SiteShell.astro';
import { getCollection } from 'astro:content';
import '../styles/site.css';

const featuredPosts = (await getCollection('blog', ({ data }) => !data.draft && data.featured))
    .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
    .slice(0, 3);
const homeUrl = new URL('/', Astro.site ?? Astro.url).href;
const personId = `${homeUrl}#person`;
const profileStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${homeUrl}#profile`,
    url: homeUrl,
    name: 'Kryštof Lískovec — DevOps & Software Developer',
    mainEntity: {
        '@type': 'Person',
        '@id': personId,
        name: 'Kryštof Lískovec',
        givenName: 'Kryštof',
        familyName: 'Lískovec',
        url: homeUrl,
        jobTitle: 'Software Developer',
        description:
            'Software developer from the Czech Republic working across DevOps, reliable systems, services, internal tools, and deployment automation.',
        homeLocation: {
            '@type': 'Country',
            name: 'Czech Republic',
        },
        knowsAbout: ['DevOps', 'Software development', 'Linux', 'Containers', 'CI/CD', 'Infrastructure automation'],
    },
};
---

<Layout
    title="Kryštof Lískovec — DevOps & Software Developer"
    description="Software developer working across DevOps, reliable systems, services, internal tools, and deployment automation."
    structuredData={profileStructuredData}
    resetScrollOnReload
>
    <SiteShell>
        <section class="solar-hero">
            <div class="solar-heading">
                <h1>
                    <span class="solar-heading-lead" id="solar-heading-lead">somewhere</span><br /><span
                        class="zoom-location-frame"><span id="zoom-location">in the solar system.</span></span
                    >
                </h1>
            </div>
            <div
                class="solar-system"
                id="solar-system"
                aria-label="A live, approximate ASCII orrery of the solar system"
            >
                <div class="solar-static" aria-hidden="true">
                    <pre>
                                      .  neptune
                              .  uranus
                       ===o===  saturn
                  O  jupiter
              .  mars       .  earth
           .  venus   .  mercury
                        .---.
                       ( SOL )
                        '---'</pre>
                </div>
                <p class="sr-only">
                    An interactive ASCII visualization of the Solar System and Milky Way introduces Kryštof Lískovec’s
                    portfolio. The portfolio content continues below with information about his DevOps and software
                    development work, technical skills, blog posts, and contact details.
                </p>
                <canvas class="solar-gpu-canvas" id="solar-gpu-canvas" aria-hidden="true"></canvas>
                <canvas
                    id="solar-canvas"
                    role="img"
                    aria-label="ASCII solar system with live approximate planetary positions"></canvas>
                <button class="object-focus-return" id="object-focus-return" type="button" hidden>[ ← return ]</button>
                <button
                    class="mobile-fullscreen-toggle"
                    id="mobile-fullscreen-toggle"
                    type="button"
                    aria-label="Open fullscreen animation"
                    aria-pressed="false"><span class="mobile-fullscreen-icon" aria-hidden="true">⛶</span></button
                >
                <div class="mobile-orientation-hint" role="status" aria-live="polite">
                    <span aria-hidden="true">↔</span> tilt phone sideways <span aria-hidden="true">↔</span>
                </div>
                <div class="cosmic-zoom-control">
                    <label class="sr-only" for="cosmic-zoom">Zoom between the Solar System and the Milky Way</label>
                    <div class="cosmic-zoom-scale">
                        <span aria-hidden="true">MILKY WAY</span>
                        <input id="cosmic-zoom" type="range" min="0" max="100" value="0" step="1" />
                        <span aria-hidden="true">SOL</span>
                        <output id="cosmic-zoom-status" for="cosmic-zoom">LOCAL SYSTEM</output>
                        <div class="simulation-speed-control">
                            <span class="sr-only" id="simulation-speed-label">Simulation speed</span>
                            <select
                                class="simulation-speed"
                                id="solar-simulation-speed"
                                aria-labelledby="simulation-speed-label"
                            >
                                <option value="0">1×</option>
                                <option value="1" selected>1h/s</option>
                                <option value="2">12h/s</option>
                                <option value="3">7d/s</option>
                                <option value="4">30d/s</option>
                                <option value="5">1y/s</option>
                            </select>
                            <select
                                class="simulation-speed"
                                id="galactic-simulation-speed"
                                aria-labelledby="simulation-speed-label"
                                hidden
                            >
                                <option value="0">1×</option>
                                <option value="1" selected>1My/s</option>
                                <option value="2">5My/s</option>
                                <option value="3">10My/s</option>
                            </select>
                            <select
                                class="simulation-speed"
                                id="rotation-simulation-speed"
                                aria-labelledby="simulation-speed-label"
                                hidden
                            >
                                <option value="0">1×</option>
                                <option value="1" selected>1h/s</option>
                                <option value="2">6h/s</option>
                                <option value="3">12h/s</option>
                                <option value="4">1d/s</option>
                            </select>
                        </div>
                    </div>
                </div>
                <label class="cosmic-zoom-switch">
                    <span class="cosmic-zoom-switch-label cosmic-zoom-switch-solar">SOL</span>
                    <input
                        id="cosmic-zoom-switch"
                        type="checkbox"
                        role="switch"
                        aria-label="Switch between the Solar System and the Milky Way"
                    />
                    <span class="cosmic-zoom-switch-track" aria-hidden="true"><span></span></span>
                    <span class="cosmic-zoom-switch-label cosmic-zoom-switch-galaxy">GALAXY</span>
                </label>
                <div class="solar-caption">
                    <div class="solar-caption-primary">
                        <span id="camera-stats">PITCH +58.0° · YAW +0.0° · ROLL −12.0°</span>
                        <div class="solar-time-controls">
                            <span id="solar-time">UTC / BROWSER TIME</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hero-footer"><a href="#about">↓ scroll to learn more</a></div>
        </section>
        <div class="profile-layout">
            <section class="content-section" id="about">
                <div class="section-label">
                    <span>01 / about me</span><span>devops + software development</span>
                </div><div class="about-grid">
                    <h2>i build reliable software and the systems it runs on.</h2>
                    <div class="about-copy">
                        <p>
                            hi there, i’m Kryštof Lískovec, a software developer from the Czech Republic working across
                            DevOps, infrastructure, and application development. my background began in backend
                            development and gradually expanded into DevOps, infrastructure, and automation.
                        </p><p>
                            these days my work sits between both. i still build services and internal tools, while also
                            working with containers, on-prem infrastructure, CI/CD, and deployments that should not wake
                            anyone up at night. along the way, i’ve helped move older codebases towards safer, cleaner
                            systems.
                        </p><p>outside work, i’m usually somewhere around Linux, homelabs, or open-source projects.</p>
                    </div>
                </div>
            </section>
            <div class="utility-grid">
                <section class="about-toolbox" id="skills">
                    <div class="section-label"><span>02 / toolbox</span><span>tools &amp; tech</span></div><div
                        class="skill-groups"
                    >
                        <div>
                            <span>operations</span><p>
                                Linux &lt;3&nbsp;· Docker&nbsp;· GitLab CI/CD&nbsp;· IaC&nbsp;· Nginx&nbsp;·
                                Consul&nbsp;· OpenBao&nbsp;· Sonatype Nexus&nbsp;· n8n
                            </p>
                        </div><div>
                            <span>data</span><p>
                                PostgreSQL&nbsp;· MySQL&nbsp;· MongoDB&nbsp;· Elasticsearch&nbsp;· Redis&nbsp;· Kibana
                            </p>
                        </div><div><span>backend</span><p>Go &lt;3&nbsp;· NestJS&nbsp;· Symfony</p></div><div>
                            <span>frontend</span><p>React&nbsp;· Svelte&nbsp;· Astro</p>
                        </div>
                    </div>
                </section>
                <section class="about-contact" id="contact">
                    <div class="section-label"><span>03 / contact</span><span>get in touch</span></div>
                    <div class="contact-links">
                        <a href="mailto:krystof@liskovec.dev">email <span>↗</span></a>
                    </div>
                </section>
            </div>
        </div>

        <section class="content-section" id="blog">
            <div class="section-label">
                <span>04 / featured posts</span><span>sometimes with opinions included</span>
            </div><PostList posts={featuredPosts} /><div class="blog-actions">
                <a class="blog-link" href="/blog">[ visit the blog → ]</a>
            </div>
        </section>
    </SiteShell>
</Layout>

<script>
    const solarHeadingLead = document.querySelector<HTMLElement>('#solar-heading-lead');
    const zoomLocation = document.querySelector<HTMLElement>('#zoom-location');
    const solarHeading = document.querySelector<HTMLElement>('.solar-heading');
    const solarSystem = document.querySelector<HTMLElement>('#solar-system');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const introStorageKey = 'liskovec:orrery-intro-seen:v3';
    const isRepeatIntro = (() => {
        try {
            return localStorage.getItem(introStorageKey) === '1';
        } catch {
            return false;
        }
    })();

    if (!reducedMotion) {
        solarHeading?.classList.add('is-intro-running');
        solarSystem?.classList.add('is-intro-running');
    }
    if (isRepeatIntro) document.documentElement.setAttribute('data-orrery-intro-repeat', '');
    document.documentElement.setAttribute('data-orrery-heading-managed', '');

    const createIntroTypewriter = (element: HTMLElement) => {
        const TYPE_DELAY_MS = 32;
        let timer = 0;
        let run = 0;

        const setText = (target: string, onComplete?: () => void) => {
            run += 1;
            const activeRun = run;
            window.clearTimeout(timer);

            if (reducedMotion) {
                element.textContent = target;
                element.classList.remove('is-typing');
                onComplete?.();
                return;
            }

            let visibleLength = 0;
            element.classList.add('is-typing');
            const step = () => {
                if (activeRun !== run) return;
                if (visibleLength < target.length) {
                    visibleLength += 1;
                    element.textContent = target.slice(0, visibleLength);
                    timer = window.setTimeout(step, TYPE_DELAY_MS);
                    return;
                }
                element.classList.remove('is-typing');
                onComplete?.();
            };
            step();
        };

        return { setText };
    };

    let headingFinished = false;
    const headingLeadWriter = solarHeadingLead ? createIntroTypewriter(solarHeadingLead) : null;
    const zoomLocationWriter = zoomLocation ? createIntroTypewriter(zoomLocation) : null;
    const loadOrrery = () => void import('../scripts/orrery.ts');
    // Give the completed heading a real paint opportunity before the heavy
    // interactive scene module begins evaluating on throttled devices.
    const ORRERY_BOOT_DELAY_MS = 320;
    const idleWindow = window as Window & {
        requestIdleCallback?: (callback: () => void, options?: { timeout?: number }) => number;
    };
    const scheduleOrrery = () => {
        window.setTimeout(() => {
            if (idleWindow.requestIdleCallback) {
                idleWindow.requestIdleCallback(loadOrrery, { timeout: 1200 });
                return;
            }
            loadOrrery();
        }, ORRERY_BOOT_DELAY_MS);
    };
    let pageLoaded = document.readyState === 'complete';
    let orreryStarted = false;
    const maybeStartOrrery = () => {
        if (!pageLoaded || orreryStarted) return;
        if (!headingFinished) return;
        orreryStarted = true;
        requestAnimationFrame(() => requestAnimationFrame(scheduleOrrery));
    };
    const finishHeading = () => {
        headingFinished = true;
        maybeStartOrrery();
    };
    window.addEventListener(
        'load',
        () => {
            pageLoaded = true;
            maybeStartOrrery();
        },
        { once: true },
    );

    if (solarHeadingLead && zoomLocation) {
        solarHeadingLead.textContent = '';
        zoomLocation.textContent = '';
        headingLeadWriter?.setText('somewhere', () => {
            zoomLocationWriter?.setText('in the solar system.', finishHeading);
        });
    } else {
        finishHeading();
    }

    let arrivalFrame = 0;
    const showSectionArrival = (section: HTMLElement) => {
        section.classList.remove('is-arriving');
        void section.offsetWidth;
        section.classList.add('is-arriving');
        section.querySelector('.section-label')?.addEventListener(
            'animationend',
            () => {
                section.classList.remove('is-arriving');
            },
            { once: true },
        );
        window.setTimeout(() => section.classList.remove('is-arriving'), 1000);
    };

    const waitForScrollEnd = (section: HTMLElement) => {
        cancelAnimationFrame(arrivalFrame);
        const startedAt = performance.now();
        let previousY = window.scrollY;
        let moved = false;
        let stableFrames = 0;
        const check = () => {
            const currentY = window.scrollY;
            if (Math.abs(currentY - previousY) > 0.5) {
                moved = true;
                stableFrames = 0;
            } else {
                stableFrames += 1;
            }
            previousY = currentY;
            const elapsed = performance.now() - startedAt;
            if ((moved && stableFrames >= 4) || (!moved && elapsed > 140) || elapsed > 1600) {
                showSectionArrival(section);
                return;
            }
            arrivalFrame = requestAnimationFrame(check);
        };
        arrivalFrame = requestAnimationFrame(check);
    };

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', () => {
            const id = link.hash.slice(1);
            const section = document.getElementById(id);
            if (
                section?.classList.contains('content-section') ||
                section?.id === 'contact' ||
                section?.id === 'skills'
            ) {
                waitForScrollEnd(section);
            }
        });
    });

    const updateNavigationState = () => {
        document.querySelectorAll<HTMLAnchorElement>('nav a').forEach((link) => {
            if (link.getAttribute('href') === '#contact') {
                if (window.location.hash === '#contact') link.setAttribute('aria-current', 'page');
                else link.removeAttribute('aria-current');
            }
        });
    };

    window.addEventListener('hashchange', updateNavigationState);
    updateNavigationState();

    if (window.location.hash) {
        const initialSection = document.getElementById(window.location.hash.slice(1));
        if (
            initialSection?.classList.contains('content-section') ||
            initialSection?.id === 'contact' ||
            initialSection?.id === 'skills'
        ) {
            waitForScrollEnd(initialSection);
        }
    }
</script>
