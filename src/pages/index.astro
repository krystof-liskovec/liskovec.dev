---
import Layout from '../layouts/Layout.astro';
import '../styles/site.css';
---

<Layout>
	<div class="site-shell">
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Krystof Liskovec home"><span>~/</span>krystof.liskovec</a>
			<nav aria-label="Primary navigation"><a href="#work">[ work ]</a><a href="#about">[ about ]</a><a href="#contact">[ contact ]</a></nav>
		</header>
		<main>
			<section class="solar-hero" id="about">
				<div class="solar-heading"><p class="eyebrow"><span class="signal">●</span> signal acquired · software engineer · cz</p><h1>somewhere<br /><span class="zoom-location-frame"><span id="zoom-location">in the solar system.</span></span></h1></div>
				<div class="solar-system" id="solar-system" aria-label="A live, approximate ASCII orrery of the solar system">
					<canvas id="solar-canvas" role="img" aria-label="ASCII solar system with live approximate planetary positions"></canvas>
					<button class="object-focus-return" id="object-focus-return" type="button" hidden>[ ← return to previous view ]</button>
					<div class="cosmic-zoom-control">
						<label class="sr-only" for="cosmic-zoom">Zoom between the Solar System and the Milky Way</label>
						<div class="cosmic-zoom-scale">
							<span aria-hidden="true">MILKY WAY</span>
							<input id="cosmic-zoom" type="range" min="0" max="100" value="0" step="1" />
							<span aria-hidden="true">SOL</span>
						</div>
						<output id="cosmic-zoom-status" for="cosmic-zoom">LOCAL SYSTEM</output>
					</div>
					<div class="solar-caption"><span>LIVE ASCII ORRERY / 3D HELIOCENTRIC</span><span id="solar-time">calculating ephemeris...</span><span>drag to spin · double-click to reset</span></div>
				</div>
				<div class="hero-footer"><span>↓ scroll to inspect the operator</span><span>orbital data: JPL / NASA · browser time</span></div>
			</section>
			<div class="status-bar"><span>╞═ SYSTEMS ONLINE</span><span>⌁ currently exploring: <b>creative engineering</b></span><span>2026.08</span></div>
			<section class="content-section" id="work"><div class="section-label"><span>01 / selected transmissions</span><span>2 artifacts found</span></div><div class="project-list"><a class="project" href="https://github.com/kristof-liskovec/liskovec.dev" target="_blank" rel="noreferrer"><div class="project-index">[ 01 ]</div><div class="project-body"><h2>liskovec.dev</h2><p>A small portfolio with a large opinion about interfaces.</p></div><div class="project-meta">astro · css <b>↗</b></div></a><a class="project" href="https://github.com/kristof-liskovec/gophershell" target="_blank" rel="noreferrer"><div class="project-index">[ 02 ]</div><div class="project-body"><h2>gophershell cli</h2><p>A developer dashboard for local container deployments and real-time logs.</p></div><div class="project-meta">go · docker · tui <b>↗</b></div></a></div></section>
			<section class="lower-grid"><div class="content-section compact"><div class="section-label"><span>02 / equipment</span><span>loadout</span></div><p class="large-copy">go · typescript · astro · react<br />postgres · docker · linux</p></div><div class="content-section compact" id="contact"><div class="section-label"><span>03 / open channel</span><span>say hello</span></div><div class="contact-links"><a href="mailto:krystof@liskovec.dev">email <span>↗</span></a><a href="https://github.com/kristof-liskovec" target="_blank" rel="noreferrer">github <span>↗</span></a><a href="https://linkedin.com/in/krystof-liskovec" target="_blank" rel="noreferrer">linkedin <span>↗</span></a></div></div></section>
		</main>
		<footer><span>© 2026 krystof liskovec</span><span>made with curiosity + caffeine</span></footer>
	</div>
</Layout>

<script>
	const planets = {
		Mercury: [0.38709927, 0.20563593, 252.2503235, 77.45779628, 149472.67411175], Venus: [0.72333566, 0.00677672, 181.9790995, 131.60246718, 58517.81538729], Earth: [1.00000261, 0.01671123, 100.46457166, 102.93768193, 35999.37244981], Mars: [1.52371034, 0.0933941, -4.55343205, -23.94362959, 19140.30268499], Jupiter: [5.202887, 0.04838624, 34.39644051, 14.72847983, 3034.74612775], Saturn: [9.53667594, 0.05386179, 49.95424423, 92.59887831, 1222.49362201], Uranus: [19.18916464, 0.04725744, 313.23810451, 170.9542763, 428.48202785], Neptune: [30.06992276, 0.00859048, -55.12002969, 44.96476227, 218.45945325]
	};
	const start = Date.UTC(2000, 0, 1, 12);
	const rad = Math.PI / 180;
	function position(planet, now) {
		const [a, e, L, peri, rate] = planets[planet];
		const centuries = (now - start) / 86400000 / 36525;
		const meanAnomaly = ((L + rate * centuries - peri) % 360) * rad;
		let eccentricAnomaly = meanAnomaly;
		for (let i = 0; i < 8; i++) eccentricAnomaly -= (eccentricAnomaly - e * Math.sin(eccentricAnomaly) - meanAnomaly) / (1 - e * Math.cos(eccentricAnomaly));
		const x = a * (Math.cos(eccentricAnomaly) - e);
		const y = a * Math.sqrt(1 - e * e) * Math.sin(eccentricAnomaly);
		return Math.atan2(y, x) / rad;
	}
	const system = document.querySelector('#solar-system');
	const canvas = document.querySelector('#solar-canvas');
	const time = document.querySelector('#solar-time');
	const ctx = canvas?.getContext('2d');
	const glyphs = { Mercury: '·', Venus: 'v', Earth: '⊕', Mars: 'm', Jupiter: 'J', Saturn: 'S', Uranus: 'U', Neptune: 'N' };
	const colors = { Mercury: '#bdae93', Venus: '#d79921', Earth: '#83a598', Mars: '#fb4934', Jupiter: '#d5c4a1', Saturn: '#fabd2f', Uranus: '#8ec07c', Neptune: '#458588' };
	const stars = Array.from({ length: 90 }, (_, i) => ({ x: (i * 47) % 97 / 97, y: (i * 23) % 89 / 89, phase: (i * 1.73) % (Math.PI * 2), size: i % 7 === 0 ? '✦' : '·' }));
	function drawAscii(now) {
		if (!canvas || !ctx) return;
		const dpr = window.devicePixelRatio || 1; const width = canvas.clientWidth; const height = canvas.clientHeight;
		canvas.width = width * dpr; canvas.height = height * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		const mobile = width < 600; const cols = mobile ? 58 : 90; const rows = mobile ? 27 : 34; const cellW = width / cols; const cellH = height / rows;
		ctx.font = `${Math.max(12, Math.min(19, cellH * 1.35))}px "DM Mono", monospace`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
		ctx.font = `${Math.max(12, Math.min(19, cellH * 1.35))}px "DM Mono", monospace`;
		stars.forEach(star => { const twinkle = (Math.sin(now / 420 + star.phase) + 1) / 2; ctx.globalAlpha = .18 + twinkle * (star.size === '✦' ? .72 : .38); ctx.fillStyle = star.size === '✦' ? '#fabd2f' : '#928374'; ctx.fillText(star.size, star.x * width, star.y * height); }); ctx.globalAlpha = 1;
		const cx = cols / 2, cy = rows / 2; const orbitX = [7, 10, 14, 18, 24, 30, 36, 42].map(v => v * (mobile ? .82 : 1)); const orbitY = [2, 3, 4, 5, 7, 9, 11, 13].map(v => v * (mobile ? .9 : 1)); const tilts = [.2, .28, .36, .44, .52, .6, .68, .76];
		const project = (x, y, z) => { const perspective = 1 + z * .028; return { x: cx + (x + z * .22) * perspective, y: cy + (y - z * .58) * perspective, z }; };
		for (let o = 0; o < orbitX.length; o++) { ctx.fillStyle = o === 2 ? '#7c6f64' : '#504945'; for (let i = 0; i < 220; i++) { const a = i / 220 * Math.PI * 2; if (i % 4 !== 0) continue; const point = project(Math.cos(a) * orbitX[o], Math.sin(a) * orbitY[o], Math.sin(a) * orbitY[o] * tilts[o] + Math.cos(a) * orbitX[o] * tilts[o] * .24); ctx.globalAlpha = point.z > 0 ? .9 : .28; ctx.fillText(i % 8 === 0 ? '-' : '.', point.x * cellW, point.y * cellH); } } ctx.globalAlpha = 1;
		const bodies = Object.keys(planets).map((name, i) => { const a = position(name, now) * rad; const point = project(Math.cos(a) * orbitX[i], Math.sin(a) * orbitY[i], Math.sin(a) * orbitY[i] * tilts[i] + Math.cos(a) * orbitX[i] * tilts[i] * .24); return { name, point, i }; }).sort((a, b) => a.point.z - b.point.z);
		const drawBody = ({ name, point }) => { const front = point.z > 0; const scale = Math.max(.72, Math.min(1.7, 1 + point.z * .035)); ctx.fillStyle = colors[name]; ctx.globalAlpha = front ? 1 : .52; ctx.font = `bold ${Math.max(13, cellH * 1.1 * scale)}px "DM Mono", monospace`; ctx.fillText(glyphs[name], point.x * cellW, point.y * cellH); ctx.font = `${Math.max(8, cellH * .62 * scale)}px "DM Mono", monospace`; ctx.fillText(name, point.x * cellW, point.y * cellH + cellH * 1.3 * scale); };
		bodies.filter(body => body.point.z <= 0).forEach(drawBody);
		ctx.fillStyle = '#fabd2f'; ctx.shadowColor = '#fe8019'; ctx.shadowBlur = 18; ctx.font = `bold ${Math.max(22, cellH * 2.2)}px "DM Mono", monospace`; ctx.fillText('☼', cx * cellW, cy * cellH); ctx.shadowBlur = 0;
		bodies.filter(body => body.point.z > 0).forEach(drawBody); ctx.globalAlpha = 1;
	}
	function tick() {
		const now = Date.now();
		drawAscii(now);
		if (time) time.textContent = new Date(now).toISOString().replace('T', ' / ').slice(0, 22) + ' UTC';
	}
	// Superseded by the perspective renderer below.
</script>

<script>
	import '../scripts/orrery.ts';
</script>
