---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { getBlogSlug } from '../../../lib/blog';
export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => !data.draft && data.locale !== 'en');
    return posts.map(post => ({ params: { lang: post.data.locale, id: getBlogSlug(post.id) }, props: { post } }));
}
---
<BlogPostPage post={Astro.props.post} />
