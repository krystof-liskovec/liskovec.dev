---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import '../styles/site.css';
---

<Layout
    title="404 — Not Found | Kryštof Lískovec"
    description="The requested page could not be found."
    canonical={false}
    noindex
>
    <SiteShell mainClass="not-found-page">
        <section class="not-found">
            <div class="not-found-scene" aria-hidden="true">
                <pre
                    class="not-found-art">
                                              ______
                                             /      \
                                             | ??!! |
                                             \______/
                                          o
                  ____           _      ·
             ____/___ `--.____.--')   ·
                    .- (  ) -.
         .-.   _.--/  _|..|_  \--._   .-.
        (O).)-| |  \   |  |   /  | |-(.(O)
         `-'  '-'-._\_/    \_/_.-'-'  `-'
             _| |   '-.____.-'   | |_
          .-' | |     | __ |     | | '-.
         /.--.' |     |/  \|     | '.--.\
        | (  )  '.    |\__/|    .'  (  ) |
         \'.___.''-. _|____|_ .-''.___.'/
          '---._|_____|----|_____|_.---'
            /  /       |::|      \  \
           /  /        |::|       \  \
          /__/_________|::|________\__\
         /  /          |::|         \  \
        /  /           |::|          \  \
     _.-'-/           _|::|_          \-' -._
    '-----'          '------'         '-----'
                </pre>
                <pre
                    class="not-found-art not-found-moon">
  +                     .           +
      .-'----'-.
    .'  o  .    '.                .                  +
   / .      O  o  \
. |    o  .      . |     +
  | .      o   O   |              .      .
   \  O  .     o  /                              .
    '.    o  .  .'
      '-.____.-'
+                                 .

             .                      +

      +                       .

                </pre>
            </div>
            <p class="eyebrow">404 - not found</p>
            <h1>your lander drifted<br /><span>somewhere else.</span></h1>
            <nav class="not-found-links" aria-label="404 navigation">
                <a class="blog-link" href="/">[ return home → ]</a>
                <a class="blog-link" href="/blog">[ visit the blog → ]</a>
            </nav>
        </section>
    </SiteShell>
</Layout>

<style>
    .not-found-page {
        display: grid;
        min-height: calc(100svh - 160px);
        align-items: center;
    }

    .not-found {
        max-width: 760px;
        padding: 90px 0 120px;
    }

    .not-found-scene {
        display: flex;
        align-items: flex-start;
        gap: clamp(4px, 1vw, 14px);
        margin: 0 0 30px;
    }

    .not-found-art {
        margin: 0;
        color: var(--orange);
        font: clamp(7px, 0.85vw, 10px) / 1.12 var(--mono);
        white-space: pre;
    }

    .not-found-moon {
        margin-top: 28px;
        color: var(--fg);
        font-size: clamp(6px, 0.75vw, 9px);
    }

    .not-found h1 {
        margin: 16px 0 24px;
        font-size: clamp(42px, 7vw, 84px);
    }

    .not-found h1 span {
        color: var(--orange);
    }

    .not-found > p:not(.eyebrow) {
        max-width: 460px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
    }

    .not-found-links {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 36px;
    }

    @media (max-width: 700px) {
        .not-found {
            padding: 70px 0 90px;
        }
    }
</style>
